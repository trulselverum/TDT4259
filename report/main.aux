\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Daily mean consumption per location. The levels differ considerably, and all Norwegian locations rise sharply from October. The Finnish series starts in July 2022 and jumps from about 2.6 to 5\,MW within a few days.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:consumption-level}{{4}{6}{Daily mean consumption per location. The levels differ considerably, and all Norwegian locations rise sharply from October. The Finnish series starts in July 2022 and jumps from about 2.6 to 5\,MW within a few days}{figure.caption.8}{}}
