\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Hourly consumption against temperature forecast per location. Consumption is nearly flat at high temperatures and rises steeply below roughly 10\,$^\circ $C. The separate low-consumption cluster at the same temperatures is the period before the level shift in autumn 2022 (see \cref  {fig:consumption-level}). Note the different y-axis scales.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:temp-scatter}{{5}{7}{Hourly consumption against temperature forecast per location. Consumption is nearly flat at high temperatures and rises steeply below roughly 10\,$^\circ $C. The separate low-consumption cluster at the same temperatures is the period before the level shift in autumn 2022 (see \cref {fig:consumption-level}). Note the different y-axis scales}{figure.caption.10}{}}
\newlabel{fig:temp-scatter@cref}{{[figure][5][]5}{[1][5][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Average daily consumption profile per location, shown relative to each location's mean and in local time, for weekdays and weekends. Norwegian locations have a morning peak on weekdays that is delayed on weekends and an evening peak that is earlier on weekends. Helsingfors is nearly flat.}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:daily-profiles}{{6}{8}{Average daily consumption profile per location, shown relative to each location's mean and in local time, for weekdays and weekends. Norwegian locations have a morning peak on weekdays that is delayed on weekends and an evening peak that is earlier on weekends. Helsingfors is nearly flat}{figure.caption.12}{}}
\newlabel{fig:daily-profiles@cref}{{[figure][6][]6}{[1][5][]8}{}{}{}}
